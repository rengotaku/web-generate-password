# Security headers for password generator
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; media-src 'self'; child-src 'none'; form-action 'self'; base-uri 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  
# Cache static assets
/style.css
  Cache-Control: public, max-age=31536000, immutable
  
/script.js
  Cache-Control: public, max-age=31536000, immutable
  
# Cache HTML with shorter duration
/index.html
  Cache-Control: public, max-age=3600